# Copy this file to .env and adjust for your local Postgres install.

# SQLAlchemy connection string to your local Postgres database.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fosterconnect

# Secret used to sign JWT access tokens. Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial admin account created by `python -m app.seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# When true, tables are auto-created on app startup (handy for local dev).
# Set to false if you prefer to manage the schema with Alembic migrations.
AUTO_CREATE_TABLES=true
